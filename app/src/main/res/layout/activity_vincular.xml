<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".VincularActivity">

    <!-- Encabezado superior -->
    <TextView
        android:id="@+id/tvTitleBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:padding="16dp"
        android:text="TrapLink - Vincular Dispositivo"
        android:textColor="@color/on_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Contenedor del Formulario -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitleBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar Nueva Trampa"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresa el numero de serie unico ubicado en la etiqueta de la trampa o utilice la camara para escanear su codigo QR"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <!-- Campo de texto manual -->
        <EditText
            android:id="@+id/etNumeroSerie"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/surface"
            android:hint="Numero de serie (Ej: TRMP-0002)"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:layout_marginBottom="16dp"
            android:elevation="1dp"/>

        <!-- Botón para Vincular Manual -->
        <Button
            android:id="@+id/btnVincularManual"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/primary"
            android:text="Vincular Manualmente"
            android:textColor="@color/on_primary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Divisor estético -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Botón para Escanear QR -->
        <Button
            android:id="@+id/btnEscanearQR"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/secondary"
            android:text="Escanear Codigo QR"
            android:textColor="@color/on_secondary"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- ================= NAVEGACIÓN INFERIOR ================= -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/primary_dark"
        android:orientation="horizontal"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnNavDispositivos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Nodos"
            android:textColor="@color/on_primary"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnNavEventos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Eventos"
            android:textColor="@color/on_primary"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnNavVincular"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/primary"
            android:text="Vincular"
            android:textColor="@color/on_primary"
            android:gravity="center"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>