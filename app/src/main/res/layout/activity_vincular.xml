<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg_light"
    tools:context=".VincularActivity">

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_badge_logo">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_smartphone"
                app:tint="@color/text_title_dark" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_title_dark"
            android:textSize="19sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btnToggleTema"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_theme_toggle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/ivToggleTemaIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_moon" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_node"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar Nueva Trampa"
                android:textColor="@color/text_title_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresa el numero de serie unico ubicado en la etiqueta de la trampa o utiliza la camara para escanear el codigo QR"
                android:textColor="@color/text_body_grey"
                android:textSize="13sp"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/etNumeroSerie"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_card_node"
                android:hint="Numero de serie (Ej: TRMP-0002)"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_title_dark"
                android:textColorHint="@color/text_body_grey"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnVincularManual"
                style="@style/Widget.TrapLink.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Vincular Manualmente" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O"
                android:gravity="center"
                android:textColor="@color/text_body_grey"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btnEscanearQR"
                style="@style/Widget.TrapLink.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escanear Codigo QR" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnNavDispositivos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_nav_nodos"
            android:drawableTint="@color/nav_icon_inactive"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="Nodos"
            android:textColor="@color/nav_icon_inactive"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnNavEventos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:clickable="true"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_nav_eventos"
            android:drawableTint="@color/nav_icon_inactive"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="Eventos"
            android:textColor="@color/nav_icon_inactive"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnNavVincular"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_active"
            android:clickable="false"
            android:drawablePadding="4dp"
            android:drawableTop="@drawable/ic_nav_vincular"
            android:drawableTint="@color/text_title_dark"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="Vincular"
            android:textColor="@color/text_title_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>