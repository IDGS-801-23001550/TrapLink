<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_node"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Círculo placeholder (imita el badge del ícono) -->
    <View
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_skeleton_circle" />

    <!-- Barras placeholder (imitan nombre + chip de estado) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="80dp"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

</LinearLayout>