<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_node"
    android:clickable="true"
    android:elevation="3dp"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Badge circular con icono de señal -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_badge_node_icon">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_node_icon"
            android:src="@drawable/ic_signal_node" />
    </FrameLayout>

    <!-- Nombre + estado + última actividad -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNumeroSerie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de Serie"
            android:textColor="@color/text_title_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Chip de estado -->
        <TextView
            android:id="@+id/tvEstadoTrampa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip_offline"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Desconectado"
            android:textColor="@color/chip_text_offline"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/cd_arrow"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>