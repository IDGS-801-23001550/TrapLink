<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg_light"
    tools:context=".Detalles">

    <!-- Header Dinámico con botón Atrás -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Botón Atrás sustituyendo al badge del logo -->
        <FrameLayout
            android:id="@+id/btnAtras"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_badge_logo"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHeaderTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_title_dark"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Toggle de Tema -->
        <FrameLayout
            android:id="@+id/btnToggleTema"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_theme_toggle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/ivToggleTemaIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_toggle_theme"
                android:src="@drawable/ic_moon" />
        </FrameLayout>
    </LinearLayout>

    <!-- Contenedor de Información Adaptable -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/bg_card_node"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <TextView
            android:id="@+id/tvDetalleNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_title_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Nombre del Nodo" />

        <TextView
            android:id="@+id/tvDetalleEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Estado: -"
            android:textColor="@color/text_body_grey"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetalleBateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Carga Física: -"
            android:textColor="@color/text_body_grey"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDetallePrediccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vida útil estimada: -"
            android:textColor="@color/secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnLocalizar"
            style="@style/Widget.TrapLink.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Localizar Dispositivo" />

        <Button
            android:id="@+id/btnDetener"
            style="@style/Widget.TrapLink.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Detener Localización" />

        <TextView
            android:id="@+id/tvTituloAcciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acciones de Campo:"
            android:textColor="@color/text_title_dark"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConfirmarReal"
            style="@style/Widget.TrapLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Confirmar Captura Real"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnFalsoPositivo"
            style="@style/Widget.TrapLink.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marcar Falso Positivo"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>