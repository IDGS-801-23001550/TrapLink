<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".Detalles">

    <TextView
        android:id="@+id/tvDetailBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:padding="16dp"
        android:text="Detalles del Dispositivo"
        android:textColor="@color/on_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDetailBar">

        <TextView
            android:id="@+id/tvDetalleNombre"
            style="@style/TextAppearance.TrapLink.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Nodo" />

        <TextView
            android:id="@+id/tvDetalleEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Estado: -"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvDetalleBateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Carga Física: -"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvDetallePrediccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Vida útil estimada: -"
            android:textColor="@color/secondary_dark"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnLocalizar"
            style="@style/Widget.TrapLink.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Localizar Dispositivo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acciones de Campo:"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnConfirmarReal"
            style="@style/Widget.TrapLink.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Confirmar Captura Real" />

        <Button
            android:id="@+id/btnFalsoPositivo"
            style="@style/Widget.TrapLink.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marcar Falso Positivo" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>